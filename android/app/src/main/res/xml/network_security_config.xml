<?xml version="1.0" encoding="utf-8"?>
<!--
  Seguridad de red: la app SOLO puede comunicarse por HTTPS.
  Cualquier petición http:// es bloqueada por Android.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
